APP_NAME="First Mile Manager Help centre"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres, as on the help centre's server. Locally: Sail's "pgsql" host, or 127.0.0.1.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=fmm_help
DB_USERNAME=sail
DB_PASSWORD=password

# Public pages never start a session (routes/public.php), so nothing needs a session store yet.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Meilisearch, which search runs on (config/help.php "search"). Locally, start one with
# meilisearch --master-key=<key> and put the same key here.
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
MEILISEARCH_INDEX=fmm_help

# The issue desk's key (config/help.php "issue_desk"): a fine-grained GitHub token with issues read
# and write on gpl-ajackson/firstmilemanager-help only, set on the server (help#2). Leave it
# empty locally: "doesn't match" votes then wait, and nothing reaches GitHub.
HELP_GITHUB_ISSUES_TOKEN=

# Cloudflare Access's service token (config/help.php "access"), for timing the page templates at
# the real address before going public (help:launch-checks --speed-at, ticket #33). Only the run
# for the Launch Check issue needs it; leave it empty locally.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# The off-server backup store for the records' nightly backups (config/filesystems.php "backups"):
# the Cloudflare R2 bucket fmm-help-backups (EU jurisdiction), its S3 address
# (https://<account>.eu.r2.cloudflarestorage.com), and an R2 token scoped to that bucket, set on
# the server (ticket #34). Leave them empty locally: help:back-up-records and help:restore-records
# then fail saying so.
HELP_BACKUP_ENDPOINT=
HELP_BACKUP_BUCKET=
HELP_BACKUP_KEY=
HELP_BACKUP_SECRET=

# Better Stack Uptime (config/help.php "uptime"): an API token and the monitors' ids, separated by
# commas, set on the server (ticket #34). Leave them empty locally: help:record-uptime then fails
# saying so.
HELP_UPTIME_API_TOKEN=
HELP_UPTIME_MONITOR_IDS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

